# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real secrets.

# --- Postgres ---
# Local Postgres 16, database created during setup (see README).
POSTGRES_DSN=postgresql://rag:rag@localhost:5432/rag

# --- Pinecone ---
# Get a free Starter-tier key at https://app.pinecone.io
PINECONE_API_KEY=
PINECONE_INDEX=rag-chatbot

# --- UI authentication ---
# Set all three in Railway. Generate AUTH_JWT_SECRET with:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_ADMIN_USERNAME=
AUTH_ADMIN_PASSWORD=
AUTH_JWT_SECRET=
# Keep true in production; set false for local HTTP development.
AUTH_COOKIE_SECURE=true

# --- LLM provider ---
# Groq is the default. Set USE_OLLAMA=true to use local Ollama instead.
USE_OLLAMA=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Optional Ollama settings ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=hadad/LFM2.5-1.2B:Q4_K_M
